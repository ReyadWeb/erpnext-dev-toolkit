{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/ReyadWeb/erpnext-dev-toolkit/schemas/api/v1/response-envelope.schema.json","title":"ERPNext Developer Toolkit API v1 response envelope","type":"object","additionalProperties":false,"required":["api_version","generated_at","command","success","data","error"],"properties":{"api_version":{"const":"1.0"},"generated_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"command":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"success":{"type":"boolean"},"data":{},"error":{}},"$defs":{"error":{"type":"object","additionalProperties":false,"required":["id","message","details"],"properties":{"id":{"enum":["invalid_arguments","unavailable","internal_error"]},"message":{"type":"string","minLength":1},"details":{"type":"object"}}}},"oneOf":[{"properties":{"success":{"const":true},"data":{"type":"object"},"error":{"type":"null"}}},{"properties":{"success":{"const":false},"data":{"type":"null"},"error":{"$ref":"#/$defs/error"}}}]}
