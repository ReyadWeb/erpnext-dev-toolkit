{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ReyadWeb/erpnext-dev-toolkit/schemas/api/v1/restore-status.schema.json",
  "$defs": {"status": {"enum": ["HEALTHY", "DEGRADED", "CRITICAL", "UNKNOWN"]}, "timestamp": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"}, "integer": {"type": ["integer", "null"], "minimum": 0}},
  "allOf": [
    {"$ref": "response-envelope.schema.json"},
    {"properties": {"command": {"const": "restore-status"}}, "oneOf": [
      {"properties": {"success": {"const": true}, "error": {"type": "null"}, "data": {
        "type": "object", "additionalProperties": false, "required": ["toolkit_version", "observed_at", "deployment", "overall_status", "candidate", "rehearsal", "readiness", "issues"],
        "properties": {
          "toolkit_version": {"type": "string"}, "observed_at": {"$ref": "#/$defs/timestamp"}, "overall_status": {"$ref": "#/$defs/status"},
          "deployment": {"type": "object", "additionalProperties": false, "required": ["engine", "site"], "properties": {"engine": {"enum": ["native", "docker", null]}, "site": {"type": ["string", "null"]}}},
          "candidate": {"type": "object", "additionalProperties": false, "required": ["available", "id", "created_at", "age_hours", "completeness", "database_available", "public_files_available", "private_files_available", "site_configuration_available", "checksum_manifest_present", "deep_verification_performed"], "properties": {"available": {"type": "boolean"}, "id": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}, "created_at": {"$ref": "#/$defs/timestamp"}, "age_hours": {"$ref": "#/$defs/integer"}, "completeness": {"enum": ["complete", "partial", "missing", "unknown"]}, "database_available": {"type": "boolean"}, "public_files_available": {"type": "boolean"}, "private_files_available": {"type": "boolean"}, "site_configuration_available": {"type": "boolean"}, "checksum_manifest_present": {"type": "boolean"}, "deep_verification_performed": {"const": false}}},
          "rehearsal": {"type": "object", "additionalProperties": false, "required": ["status", "recorded", "recorded_at", "successful", "site_matches", "candidate_matches", "login_validated"], "properties": {"status": {"$ref": "#/$defs/status"}, "recorded": {"type": "boolean"}, "recorded_at": {"$ref": "#/$defs/timestamp"}, "successful": {"type": ["boolean", "null"]}, "site_matches": {"type": ["boolean", "null"]}, "candidate_matches": {"type": ["boolean", "null"]}, "login_validated": {"type": ["boolean", "null"]}}},
          "readiness": {"type": "object", "additionalProperties": false, "required": ["database_restore_candidate", "full_restore_candidate", "matching_rehearsal_proven", "deep_integrity_verified", "live_restore_performed"], "properties": {"database_restore_candidate": {"type": "boolean"}, "full_restore_candidate": {"type": "boolean"}, "matching_rehearsal_proven": {"type": "boolean"}, "deep_integrity_verified": {"const": false}, "live_restore_performed": {"const": false}}},
          "issues": {"type": "array", "uniqueItems": true, "items": {"enum": ["configuration_unavailable", "backup_directory_missing", "backup_directory_unsafe", "backup_directory_unreadable", "backup_scan_truncated", "backup_set_partial", "backup_set_missing", "backup_evidence_changed", "off_vm_not_configured", "off_vm_last_run_failed", "object_storage_not_configured", "object_storage_last_run_failed", "rehearsal_missing", "rehearsal_failed", "rehearsal_site_mismatch", "rehearsal_candidate_mismatch", "rehearsal_evidence_unsafe", "deep_verification_not_performed"]}}
        }
      }}},
      {"properties": {"success": {"const": false}, "data": {"type": "null"}, "error": {"$ref": "response-envelope.schema.json#/$defs/error"}}}
    ]}
  ]
}
