{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/ReyadWeb/erpnext-dev-toolkit/schemas/api/v1/api-version.schema.json","title":"ERPNext Developer Toolkit api-version response","type":"object","additionalProperties":false,"required":["api_version","generated_at","command","success","data","error"],"properties":{"api_version":{"const":"1.0"},"generated_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"command":{"const":"api-version"},"success":{"type":"boolean"},"data":{},"error":{}},"oneOf":[{"properties":{"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["current_api_version","supported_api_versions","toolkit_version"],"properties":{"current_api_version":{"const":"1.0"},"supported_api_versions":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},"toolkit_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z][0-9A-Za-z.-]*)?$"}}},"error":{"type":"null"}}},{"properties":{"success":{"const":false},"data":{"type":"null"},"error":{"type":"object","additionalProperties":false,"required":["id","message","details"],"properties":{"id":{"type":"string"},"message":{"type":"string"},"details":{"type":"object"}}}}}]}
