{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/ReyadWeb/erpnext-dev-toolkit/schemas/api/v1/capabilities.schema.json","title":"ERPNext Developer Toolkit capabilities response","type":"object","additionalProperties":false,"required":["api_version","generated_at","command","success","data","error"],"properties":{"api_version":{"const":"1.0"},"generated_at":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"},"command":{"const":"capabilities"},"success":{"const":true},"data":{"type":"object","additionalProperties":false,"required":["capabilities"],"properties":{"capabilities":{"type":"array","items":{"$ref":"#/$defs/capability"}}}},"error":{"type":"null"}},"$defs":{"capability":{"type":"object","additionalProperties":false,"required":["name","aliases","requires_root","operation_mode","lock_policy","interaction_mode","risk_classification","supported_engines","json_available","stable_api_contract","api_contract_version"],"properties":{"name":{"type":"string","pattern":"^[a-z0-9][a-z0-9-]*$"},"aliases":{"type":"array","items":{"type":"string"}},"requires_root":{"type":"boolean"},"operation_mode":{"enum":["read-only","mutating"]},"lock_policy":{"enum":["none","required"]},"interaction_mode":{"enum":["interactive","non-interactive","both"]},"risk_classification":{"enum":["safe","administrative","destructive"]},"supported_engines":{"type":"array","items":{"enum":["docker","native"]},"minItems":1,"uniqueItems":true},"json_available":{"type":"boolean"},"stable_api_contract":{"type":"boolean"},"api_contract_version":{"type":["string","null"]}}}}}
